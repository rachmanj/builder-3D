itance chain.","operationId":"get_process_detail_profiles_processes__setting_id__get","parameters":[{"name":"setting_id","in":"path","required":true,"schema":{"type":"string","title":"Setting Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/profiles/filaments/{setting_id}":{"delete":{"tags":["Profiles"],"summary":"Delete Filament Profile","description":"Delete a user-imported custom filament profile.","operationId":"delete_filament_profile_profiles_filaments__setting_id__delete","parameters":[{"name":"setting_id","in":"path","required":true,"schema":{"type":"string","title":"Setting Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FilamentProfileDeleteResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"get":{"tags":["Profiles"],"summary":"Get Filament Detail","description":"Return a fully-resolved filament profile with inheritance chain.","operationId":"get_filament_detail_profiles_filaments__setting_id__get","parameters":[{"name":"setting_id","in":"path","required":true,"schema":{"type":"string","title":"Setting Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/options/process":{"get":{"tags":["Options"],"summary":"Get Process Options","description":"Per-option metadata catalogue for process-domain options.\n\nSourced from libslic3r's print_config_def via orca-headless dump-options.\nUnfiltered — every process-domain option is included so iOS/web can render\nlabels for keys that are modified o